--- !u!114 &308605277629073007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 308605277629073011}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: df24b820348d4ed42ba9130d9e7a25b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  canProgramend: 0
  m_MainText: {fileID: 308605276436469939}
  m_Codigo: "using System.Collections;\r\nusing UnityEngine.UI;\r\nusing UnityEngine;\r\nusing
    TMPro;\r\n\r\npublic class Programming : MonoBehaviour\r\n{\r\n    [Header(\"===Programming===\")]\r\n   
    public bool canProgramend = false;\r\n    public TextMeshProUGUI m_MainText;\r\n   
    [TextArea(5, 20)] public string m_Codigo;\r\n    public Vector2 m_FontSize =
    new Vector2(36, 80);\r\n\r\n    [Header(\"===Visual===\")]\r\n    [Space]\r\n   
    public TextMeshProUGUI m_Title;\r\n    public ParticleSystem particle;\r\n   
    public Image progressFill;\r\n    public Color[] color;\r\n\r\n    [Header(\"===Scroll===\")]\r\n   
    [Space]\r\n    public RectTransform m_Scroll;\r\n    public float m_ScrollSpeed
    = 4.5f;\r\r\n\r\n    \r\n    Pc_Manager pc_Manager;\r\n    Developer developer;\r\n   
    float scrollSizeY = 246.79f;\r\n    int countClicks = 0;\r\n    \n\r\n    private
    void Start()\r\n    {\r\n        pc_Manager = Pc_Manager.Instance;\r\n       
    developer = Developer.Instance;\r\n    }\r\n\r\n    private void OnEnable()\r\n   
    {\r\n        if (developer.gamesReady.Count > 0)\r\n            canProgramend
    = !developer.gamesReady[developer.gamesReady.Count - 1];\r\n        else\r\n           
    canProgramend = false;\r\n\r\n        SetProgress((pc_Manager.m_Progress / pc_Manager.m_NecessaryProgress
    * 100) * 0.01f);\r\n\r\n        TextFontSize(0);\r\n    }\r\n\r\n    private
    void Update()\r\n    {\r\n        if (!CanProgramming())\r\n            return;\r\n\r\n       
    if (Input.anyKeyDown)\r\n            if (!Input.GetMouseButtonDown(0) || !Input.GetMouseButtonDown(1)
    || !Input.GetKeyDown(KeyCode.Escape) || !Input.GetKeyDown(KeyCode.KeypadEnter)
    || !Input.GetKeyDown(KeyCode.Space))\r\n                Constructor();\r\n   
    }\r\n\r\n    public void NewGame(string namme)\r\n    {\r\n        m_Title.text
    = \"Vai Sonhando -\" + \" \" + namme;\r\n        canProgramend = true;\r\n       
    ChangeColorText();\r\n        Resett();\r\n    }\r\n\r\n    private void Constructor()\r\n   
    {\r\n        pc_Manager.m_Progress++;\r\n        countClicks++;\r\n\r\n       
    m_Scroll.sizeDelta += new Vector2(0, m_ScrollSpeed);\r\n        m_Scroll.GetComponentInParent<ScrollRect>().verticalNormalizedPosition
    = 0;\r\n\r\n        for (int i = m_MainText.text.Length; i <= m_MainText.text.Length
    + 10; i++)\r\n        {\r\n            if (i < m_Codigo.Length)\r\n               
    m_MainText.text += m_Codigo[i];\r\n            else\r\n            {\r\n               
    m_MainText.text = \"\";\r\n                m_Scroll.sizeDelta = new Vector2(m_Scroll.sizeDelta.x,
    scrollSizeY);\r\n            }\r\n        }\r\n\r\n        SetProgress(pc_Manager.m_Progress
    / pc_Manager.m_NecessaryProgress * 100);\r\n\r\n        if (countClicks >= 10)\r\n           
    ChangeColorText();\r\n\r\n        if (pc_Manager.m_Progress >= pc_Manager.m_NecessaryProgress)\r\n           
    EndProgramming();\r\n    }\r\n\r\n    private void EndProgramming()\r\n    {\r\n       
    TextFontSize(1);\r\n\r\n        m_MainText.color = Color.white;\r\n        m_MainText.text
    = \"Complete\\n\";\r\n        m_MainText.text += \"100%\";\r\n        canProgramend
    = false;\r\n\r\n        StartCoroutine(BackToDevelopment());\r\n    }\r\n\r\n   
    private void Resett()\r\n    {\r\n        m_MainText.text = \"\";\r\n       
    pc_Manager.m_Progress = 0;\r\n        progressFill.fillAmount = 0;\r\n       
    m_Scroll.sizeDelta = new Vector2(m_Scroll.sizeDelta.x, scrollSizeY);\r\n    }\r\n\r\n   
    private bool CanProgramming()\r\n    {\r\n        if (!canProgramend || !pc_Manager.on_PC
    || Time.deltaTime <= 0)\r\n            return false;\r\n        else\r\n           
    return true;\r\n    }\r\n    #endregion\r\n\r\n    #region Visual\r\n    private
    void ChangeColorText()\r\n    {\r\n        m_MainText.color = color[Random.Range(0,
    color.Length)];\r\n        var emitParams = new ParticleSystem.EmitParams();\r\n       
    particle.Emit(emitParams, 1);\r\n        countClicks = 0;\r\n    }\r\n\r\n   
    private void TextFontSize(int size)\r\n    {\r\n        if (size > 0)\r\n       
    {\r\n            m_MainText.alignment = TextAlignmentOptions.MidlineGeoAligned;\r\n           
    m_MainText.fontSize = m_FontSize.y;\r\n        }\r\n        else\r\n        {\r\n           
    m_MainText.alignment = TextAlignmentOptions.TopLeft;\r\n            m_MainText.fontSize
    = m_FontSize.x;\r\n        }\r\n    }\r\n\r\n    private void SetProgress(float
    fill)\r\n    {\r\n        iTween.ValueTo(gameObject, iTween.Hash(\"from\", progressFill.fillAmount
    * 100, \"to\", fill, \"time\", 0.5f, \"onupdate\", \"onvalueChange\"));\r\n   
    }\r\n\r\n    private void onvalueChange(float value)\r\n    {\r\n        progressFill.fillAmount
    = value * 0.01f;\r\n    }\r\n    #endregion\r\n\r\n    IEnumerator BackToDevelopment()\r\n   
    {\r\n        WaitForSeconds wfs = new WaitForSeconds(0.6f);\r\n        yield
    return wfs;\r\n        Resett();\r\n        pc_Manager.ActivateApp(0);\r\n       
    Developer.Instance.Ready();\r\n    }"
  m_FontSize: {x: 36, y: 250}
  developer: {fileID: 308605275836019837}
  pc_Manager: {fileID: 308605277035705021}

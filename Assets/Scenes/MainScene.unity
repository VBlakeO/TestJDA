--- !u!114 &21414433
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 21414428}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d980927ac04cc7045b956ca1d49c91f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  SoftwareScreen: {fileID: 606385902}
  exitButton: {fileID: 504454478}
  highLightIcon: {fileID: 2117709248}
  pc_Manager: {fileID: 21414437}
  minimumProgressNeeded: 150
  sourceCodeText: {fileID: 1829660718}
  miniSourceCodeText: {fileID: 701078288}
  sourceCodeString: "using System.Collections;\r\nusing UnityEngine.UI;\r\nusing
    UnityEngine;\r\nusing TMPro;\r\n\r\npublic class Programming : BasePage\r\n{\r\n   
    #region Singleton\r\n    public static Programming Instance;\r\n    #endregion\r\n\r\n   
    #region public\r\n    [Header(\"===Programming===\")]\r\n    public int baseProgress
    = 150;\r\n    \r\n\r\n    public TextMeshProUGUI codeBodyText = null;\r\n   
    public TextMeshProUGUI codeBodyMiniText = null;\r\n\r\n    [Space]\r\n    [TextArea(5,
    20)] public string codigo;\r\n\r\n    [Header(\"===Visual===\")]\r\n    [Space]\r\n   
    public TextMeshProUGUI softwareTitle;\r\n    public Image progressFill;\r\n   
    public Color[] color;\r\n\r\n    [Header(\"===Scroll===\")]\r\n    [Space]\r\n   
    public RectTransform scrollRect;\r\n    public float scrollSpeed = 4.5f;\r\n  
    \r\n\r\n    [HideInInspector] \r\n    public bool workingExternally = false;\r\n\r\n   
    [HideInInspector]\r\n    public float progress, necessaryProgress;\r\n    #endregion\r\n   
    \r\n\r\n    #region private\r\n    private int _countClicks = 0;\r\n    private
    float _scrollSizeY = 0f;\r\n    #endregion\r\n\r\n    public DevOp m_Developer;\r\n   
    Pc_Manager m_PcManager;\r\n\r\n    #region start\r\n    private void Awake()\r\n   
    {\r\n        Instance = this;\r\n    }\r\n\r\n    private void Start()\r\n   
    {\r\n        m_Developer = DevOp.Instance;\r\n        m_PcManager = GetComponent<Pc_Manager>();\r\n   
    }\r\n    #endregion\r\n    \r\n    private void Update()\r\n    {\r\n\r\n       
    if (!softwareScreen.activeInHierarchy)\r\n            return;\r\n\r\n       
    if (!CanProgramming())\r\n            return;\r\n\r\n        if (Input.anyKeyDown)\r\n       
    {\r\n            if(!Input.GetKeyDown(KeyCode.Mouse0) || !Input.GetKeyDown(KeyCode.Mouse1)
    || \r\n               !Input.GetKeyDown(KeyCode.Escape) || !Input.GetKeyDown(KeyCode.KeypadEnter)
    || !Input.GetKeyDown(KeyCode.Space))\r\n                Constructor();\r\n       
    }\r\n\r\n        if (Input.GetKeyDown(KeyCode.F1))\r\n        {\r\n           
    EndProgramming();\r\n        }\r\n\r\n        SetCurrentProgress(progress / necessaryProgress);\r\n   
    }\r\n\r\n    public override void OpenSoftware()\r\n    {\r\n        base.OpenSoftware();\r\n       
    OnEnableTab();\r\n    }\r\n\r\n    private void OnEnableTab()\r\n    {\r\n       
    if (!softwareScreen.activeInHierarchy)\r\n            return;\r\n\r\n       
    if (_scrollSizeY == 0)\r\n            _scrollSizeY = scrollRect.sizeDelta.y;\r\n\r\n       
    float currentProgress = progress / necessaryProgress;\r\n        if (currentProgress
    != float.NaN)\r\n            SetCurrentProgress(currentProgress);\r\n    }\r\n\r\n   
    public void NewGame(string name, float progressNeeded)\r\n    {\r\n        m_PcManager.OnStartProject();\r\n       
    softwareTitle.text = \"Programming -\" + \" \" + name;\r\n\r\n        necessaryProgress
    = progressNeeded;\r\n\r\n        ChangeColorText();\r\n    }\r\n\r\n\r\n    #region
    Programming\r\n    public bool CanProgramming()\r\n    {\r\n        return m_PcManager.on_PC
    && Time.timeScale > 0 && progress < necessaryProgress && (m_Developer.HasGameInProgress()
    || workingExternally);\r\n    }\r\n  \r\n    private void Constructor()\r\n   
    {\r\n        progress++;\r\n        _countClicks++;\r\n\r\n        scrollRect.sizeDelta
    += new Vector2(0, scrollSpeed);\r\n        scrollRect.GetComponentInParent<ScrollRect>().verticalNormalizedPosition
    = 0;\r\n\r\n        int textLength = codeBodyText.text.Length;\r\n        for
    (int i = textLength; i <= textLength + 10; i++)\r\n        {\r\n            if
    (i < codigo.Length)\r\n            {\r\n                codeBodyText.text +=
    codigo[i];\r\n            }\r\n            else\r\n            {\r\n               
    codeBodyText.text = \"\";\r\n                scrollRect.sizeDelta = new Vector2(scrollRect.sizeDelta.x,
    _scrollSizeY);\r\n            }\r\n        }\r\n\r\n        codeBodyMiniText.text
    = codeBodyText.text;\r\n\r\n        if (_countClicks >= 10)\r\n            ChangeColorText();\r\n\r\n       
    if (progress >= necessaryProgress)\r\n            EndProgramming();\r\n    }\r\n\r\n   
    public void EndProgramming()\r\n    {\r\n        if (workingExternally)\r\n       
    {\r\n            workingExternally = false;\r\n            progress = 0;\r\n           
    m_PcManager.OpenSoftware(2);\r\n            NewLinkedOff.Instance.PlayerPayment();\r\n       
    }\r\n        else\r\n        {\r\n            StartCoroutine(BackToDevelopment());\r\n           
    m_PcManager.OnFinishedProject();\r\n        }\r\n       \r\n        SetCurrentProgress(0);\r\n       
    codeBodyText.text = \"\";\r\n        codeBodyMiniText.text = \"\";\r\n       
    scrollRect.sizeDelta = new Vector2(scrollRect.sizeDelta.x, _scrollSizeY);\r\n   
    }\r\n    #endregion\r\n    \r\n    #region Visual\r\n    private void SetCurrentProgress(float
    progress)\r\n    {\r\n        progressFill.fillAmount = progress;\r\n    }\r\n\r\n   
    private void ChangeColorText()\r\n    {\r\n        codeBodyText.color = color[Random.Range(0,
    color.Length)];\r\n        codeBodyMiniText.color = color[Random.Range(0, color.Length)];\r\n       
    _countClicks = 0;\r\n    }\r\n    #endregion\r\n\r\n    private IEnumerator BackToDevelopment()\r\n   
    {\r\n        WaitForSeconds wfs = new WaitForSeconds(1f);\r\n        yield return
    wfs;\r\n        m_PcManager.OpenSoftware(0);\r\n        DevOp.Instance.FinishedProgramming();\r\n   
    }\r\n}\r\n"
  softwareTitle: {fileID: 1808014998}
  TextColorVariation:
  - {r: 0, g: 0.6320754, b: 0.064873904, a: 1}
  - {r: 0.010412939, g: 0.5888888, b: 0.735849, a: 1}
  - {r: 0.7372549, g: 0.50095415, b: 0.011764727, a: 1}
  rectTransform: {fileID: 1974264265}
  scrollRect: {fileID: 1974264266}
  scrollSpeed: 17
  developer: {fileID: 21414439}
  externalWorkInProgress: 0
  audioList: {fileID: 1448083432}
  gameProgress: {fileID: 1661368875}
